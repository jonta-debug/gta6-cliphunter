# Local controller database. PostgreSQL support is planned behind the same store interface.
CLIPHUNTER_DATABASE_PATH=./data/cliphunter.db

# Offline chat detector settings.
CLIPHUNTER_WINDOW_SECONDS=10
CLIPHUNTER_STRIDE_SECONDS=5
CLIPHUNTER_BASELINE_WINDOWS=24
CLIPHUNTER_MIN_BASELINE_WINDOWS=6
CLIPHUNTER_HYPE_THRESHOLD=5.5
CLIPHUNTER_COOLDOWN_SECONDS=45
CLIPHUNTER_CLIP_PRE_ROLL_SECONDS=30
CLIPHUNTER_CLIP_POST_ROLL_SECONDS=20

# Explainable score component weights. They are normalized at runtime.
CLIPHUNTER_WEIGHT_FREQUENCY=0.32
CLIPHUNTER_WEIGHT_RELATIVE_ACTIVITY=0.28
CLIPHUNTER_WEIGHT_PARTICIPANTS=0.22
CLIPHUNTER_WEIGHT_EMOTES=0.10
CLIPHUNTER_WEIGHT_CAPS=0.08
CLIPHUNTER_SURPRISE_SCALE=3.0
CLIPHUNTER_RELATIVE_FULL_SCALE=4.0

# Twitch EventSub WebSocket chat. Do not commit real values.
# The token must be a user access token for TWITCH_USER_ID with user:read:chat.
TWITCH_CLIENT_ID=
TWITCH_USER_ACCESS_TOKEN=
TWITCH_USER_ID=
# Preferred: up to five broadcaster logins, resolved through the official Get Users API.
TWITCH_CHANNELS=rockstargames
# Optional numeric-ID alternative/addition. Leave empty when using only logins.
TWITCH_CHANNEL_IDS=
TWITCH_MIN_TOKEN_LIFETIME_SECONDS=300

# Normally keep the official URL. Override only for local Twitch CLI testing.
TWITCH_EVENTSUB_WEBSOCKET_URL=wss://eventsub.wss.twitch.tv/ws
TWITCH_RECONNECT_BASE_SECONDS=1
TWITCH_RECONNECT_MAX_SECONDS=30
TWITCH_KEEPALIVE_GRACE_SECONDS=5

# Optional Telegram manual review. Leave all three empty to disable Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=
